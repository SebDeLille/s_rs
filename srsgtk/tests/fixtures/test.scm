(define data '(3 7 2 9 5 6 15 1 2))

(define draw-histogram (lambda (w h)
                         (clear-canvas)
                         (let* ((n (length data))
                                 (max-val (apply max data))
                                 (margin 20)
                                 (usable-w (- w (* 2 margin)))
                                 (usable-h (- h (* 2 margin)))
                                 (bar-w (/ (exact->inexact usable-w) n)))
                           (set-color 0.2 0.5 0.8)
                           (do ((i 0 (+ i 1))
                                 (rest data (cdr rest)))
                             ((null? rest))
                             (let* ((val (car rest))
                                     (bar-h (* usable-h (/ (exact->inexact val) max-val)))
                                     (x (+ margin (* i bar-w)))
                                     (y (- h margin bar-h)))
                               (draw-rect x y (- bar-w 2) bar-h))))))

(set-redraw-hook! draw-histogram)